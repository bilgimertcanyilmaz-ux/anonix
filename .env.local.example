# Supabase bağlantı bilgileri
# Bu dosyayı ".env.local" olarak kopyalayıp kendi değerlerinizle doldurun.
# Değerleri Supabase panelinden: Project Settings > API bölümünden alabilirsiniz.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Yayına alınınca sitenin gerçek alan adı (SEO / sitemap / canonical için)
NEXT_PUBLIC_SITE_URL=https://anonix.app

# --- Ödeme (iyzico) — yalnızca SUNUCU tarafı, ASLA istemciye gitmez ---
# Supabase service_role anahtarı (Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# iyzico (sandbox veya canlı) anahtarları
IYZIPAY_API_KEY=your-iyzico-api-key
IYZIPAY_SECRET_KEY=your-iyzico-secret-key
IYZIPAY_BASE_URL=https://sandbox-api.iyzipay.com

# --- E-posta (Resend) — opsiyonel; aktifleştirmek için: npm i resend ---
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=Anonix <noreply@anonix.app>
ADMIN_EMAIL=admin@anonix.app
